APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Keep keys in your local .env file only. Never use NEXT_PUBLIC_ for secrets.
# Use mock for an offline demo; openrouter or openai for real AI.
AI_PROVIDER=mock
# For OpenRouter, copy a model ID with structured-output support from its catalog.
AI_PRIMARY_MODEL=
AI_WORKER_MODEL=
AI_MAX_OUTPUT_TOKENS=8000
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
AI_MAX_TASKS=8
MANAGEMENT_MAX_REVISIONS=2

DATABASE_URL=sqlite:///./aegisflow.db
TRUSTED_HOSTS=localhost,127.0.0.1,backend
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BYTES=1000000
# Set this in shared/production deployments to protect workflow deletion.
ADMIN_API_KEY=
SIMULATE_REPORT_FAILURE=false

# Presentation mode: back up and clear saved work on backend launch.
RESET_DEMO_ON_START=true
